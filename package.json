{
  "name": "sredi-svoih-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "mobile:iphone": "node ./scripts/startMobileIphoneLocal.mjs",
    "web": "expo start --web",
    "import:events:dry": "node ./scripts/importWebsiteEvents.mjs --dry-run",
    "import:events": "node ./scripts/importWebsiteEvents.mjs",
    "import:events:review": "node ./scripts/importWebsiteEvents.mjs --review",
    "validate:app-capabilities": "node ./scripts/validateAppCapabilities.mjs",
    "validate:mobile-iphone-local-runtime": "node ./scripts/validateMobileIphoneLocalRuntime.mjs",
    "validate:mobile-account-deletion": "node ./scripts/validateMobileAccountDeletion.mjs",
    "validate:mobile-signup-email-verification": "node ./scripts/validateMobileSignupEmailVerification.mjs",
    "validate:blessings": "node ./scripts/validateBlessingsCatalog.mjs",
    "validate:local-data-foundation": "node ./scripts/validateLocalDataFoundation.mjs",
    "validate:guest-prayer-actions": "node ./scripts/validateGuestPrayerActions.mjs",
    "validate:guest-prayer-history": "node ./scripts/validateGuestPrayerHistoryControls.mjs",
    "validate:guest-event-registration-boundary": "node ./scripts/validateGuestEventRegistrationBoundary.mjs",
    "validate:guest-runtime-boundaries": "node ./scripts/validateGuestRuntimeBoundaries.mjs",
    "validate:guest-settings-shell": "node ./scripts/validateGuestSettingsShell.mjs",
    "validate:local-prayer-notification-settings": "node ./scripts/validateLocalPrayerNotificationSettings.mjs",
    "validate:local-prayer-repository": "node ./scripts/validateLocalPrayerRepository.mjs",
    "validate:local-preferences": "node ./scripts/validateLocalPreferences.mjs",
    "validate:parsha-content": "node ./scripts/validateParshaContent.mjs",
    "validate:prayer-provider": "node ./scripts/validatePrayerTrackerProviderSelection.mjs",
    "check:mobile-guest-release": "node ./scripts/checkMobileGuestRelease.mjs",
    "check:web-registration-parity": "node ./scripts/validateWebRegistrationParity.mjs",
    "typecheck": "tsc --noEmit",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:typecheck": "npm --prefix apps/admin run typecheck",
    "admin:preview": "npm --prefix apps/admin run preview",
    "web:dev": "npm --prefix apps/web run dev",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:test": "npm --prefix apps/web run test",
    "web:build": "npm --prefix apps/web run build",
    "web:preview": "npm --prefix apps/web run preview"
