  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "typescript": "~6.0.3"
  }
