    "expo-contacts": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
