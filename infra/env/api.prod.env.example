# Backend-only production contract with fake placeholders.
# Copy decisions into the ignored, chmod-restricted server file
# infra/env/.env.api.production. Never use this example as real configuration.

APP_NAME=sredi-svoih-api
APP_ENV=production
API_VERSION=0.1.0
GIT_SHA=<immutable-git-sha>
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://sredi_api:replace-with-strong-random-database-password@api_postgres:5432/sredi_api
API_JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt-signing
API_TOKEN_HASH_SECRET=replace-with-a-distinct-at-least-32-byte-random-secret
API_JWT_ISSUER=sredi-svoih-api
API_JWT_AUDIENCE=<jwt-audience>
MIGRATION_ACCEPT_SUPABASE_JWT=false

# Email remains disabled until a reviewed production SMTP delivery path exists.
API_EMAIL_ENABLED=false
API_CORS_ALLOWED_ORIGINS=https://admin.example.invalid,https://public-web.example.invalid
PUBLIC_WEB_BASE_URL=https://public-web.example.invalid
API_PUBLIC_APP_BASE_URL=https://public-app.example.invalid

# Compose does not provision object storage. Replace these placeholders only
# after the external Russia-hosted S3-compatible service has been reviewed.
API_OBJECT_STORAGE_ENABLED=false
API_OBJECT_STORAGE_ENDPOINT_URL=https://s3-api.example.invalid
API_OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=https://s3-public.example.invalid
API_OBJECT_STORAGE_REGION=replace-with-provider-region
API_OBJECT_STORAGE_BUCKET=replace-with-private-avatar-bucket
API_OBJECT_STORAGE_EVENT_IMAGES_BUCKET=replace-with-event-images-bucket
API_OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
API_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
API_OBJECT_STORAGE_PATH_STYLE=false
API_EVENT_IMAGE_PUBLIC_BASE_URL=

# Push has no service in the production Compose topology.
API_PUSH_ENABLED=false
API_PUSH_PRODUCTION_SIGNOFF=false

# The worker profile is opt-in. Enabling it also requires separately reviewed
# encryption, delivery-window, storage, email, and legal retention decisions.
API_PRIVACY_ERASURE_WORKER_ENABLED=false
