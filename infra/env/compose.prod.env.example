# Fake values for validating infra/docker-compose.prod.yml only.
# On the server, the owner creates ignored infra/env/.env.compose.production
# and points API_ENV_FILE at ./env/.env.api.production.
SREDI_API_IMAGE=sredi-svoih-api:production-example
API_ENV_FILE=./env/api.prod.env.example
POSTGRES_DB=sredi_api
POSTGRES_USER=sredi_api
POSTGRES_PASSWORD=replace-with-strong-random-database-password
