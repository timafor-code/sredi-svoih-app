# Backend-only local API contour configuration.
# Do not copy these values into mobile, Expo, Vite, or apps/admin env files.
POSTGRES_DB=sredi_api
POSTGRES_USER=sredi_api
POSTGRES_PASSWORD=sredi_api
APP_NAME=sredi-svoih-api
APP_ENV=local
API_VERSION=0.1.0-local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://sredi_api:sredi_api@api_postgres:5432/sredi_api
API_JWT_SECRET=local-dev-jwt-secret-change-me-minimum-32-bytes
API_ACCESS_TOKEN_TTL_MINUTES=15
API_REFRESH_TOKEN_TTL_DAYS=30
API_TOKEN_HASH_SECRET=local-dev-token-hash-secret-change-me-minimum-32-bytes
API_JWT_ISSUER=sredi-svoih-api
API_JWT_AUDIENCE=
API_EMAIL_ENABLED=true
API_EMAIL_FROM_ADDRESS=local@sredi-svoih.test
API_EMAIL_FROM_NAME=Sredi Svoih Local
API_EMAIL_SMTP_HOST=api_mailpit
API_EMAIL_SMTP_PORT=1025
API_EMAIL_SMTP_USERNAME=
API_EMAIL_SMTP_PASSWORD=
API_EMAIL_SMTP_STARTTLS=false
API_AUTH_EMAIL_RATE_LIMIT_WINDOW_SECONDS=900
API_AUTH_EMAIL_RATE_LIMIT_MAX_ATTEMPTS=5
API_WEB_REGISTRATION_INTENT_TTL_HOURS=24
API_WEB_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900
API_WEB_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=10
API_WEB_REGISTRATION_CODE_TTL_MINUTES=15
API_WEB_REGISTRATION_CODE_MAX_ATTEMPTS=5
API_WEB_REGISTRATION_RESEND_COOLDOWN_SECONDS=60
PUBLIC_WEB_BASE_URL=http://localhost:5174
API_PUBLIC_APP_BASE_URL=http://localhost:8081
API_OBJECT_STORAGE_ENABLED=true
API_OBJECT_STORAGE_ENDPOINT_URL=http://api-object-storage:9000
API_OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:59000
API_OBJECT_STORAGE_REGION=us-east-1
API_OBJECT_STORAGE_BUCKET=avatars
API_OBJECT_STORAGE_ACCESS_KEY_ID=sredi_local_avatar_access
API_OBJECT_STORAGE_SECRET_ACCESS_KEY=sredi_local_avatar_secret_minio_only
API_OBJECT_STORAGE_PATH_STYLE=true
API_AVATAR_UPLOAD_URL_TTL_SECONDS=300
API_AVATAR_READ_URL_TTL_SECONDS=300
API_AVATAR_MAX_SIZE_BYTES=5242880

# Synthetic local-only privacy-erasure worker configuration.
# The notification key is not a real secret. The 365-day retention duration is
# not a production policy, not a legal retention decision, and is not approved
# for production use. It exists only so local paid-registration deletion can
# exercise the existing completed_with_retention path.
API_PRIVACY_ERASURE_WORKER_ENABLED=true
API_PRIVACY_ERASURE_POLL_INTERVAL_SECONDS=5
API_PRIVACY_ERASURE_BATCH_SIZE=10
API_PRIVACY_ERASURE_NOTIFICATION_KEY_B64=c3JlZGktbG9jYWwtZXJhc3VyZS1rZXktMzItYnl0ZSE=
API_PRIVACY_ERASURE_NOTIFICATION_KEY_ID=local-dev-erasure-v1
API_PRIVACY_ERASURE_NOTIFICATION_DELIVERY_WINDOW_HOURS=24
API_PRIVACY_ERASURE_FINANCIAL_RETENTION_DAYS=365

API_PUSH_ENABLED=false
API_PUSH_PRODUCTION_SIGNOFF=false
API_PUSH_TOKEN_ENVIRONMENT=development
API_EXPO_PUSH_ACCESS_TOKEN=
API_EXPO_PUSH_SEND_URL=https://exp.host/--/api/v2/push/send
API_EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
API_PUSH_POLL_INTERVAL_SECONDS=5
API_PUSH_RECEIPT_DELAY_MINUTES=15
API_PUSH_REQUEST_TIMEOUT_SECONDS=15
