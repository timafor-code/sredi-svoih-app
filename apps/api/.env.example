# Backend-only local API configuration. Do not copy these values into mobile,
# Expo, Vite, or apps/admin environment files.
APP_NAME=sredi-svoih-api
APP_ENV=local
API_VERSION=0.1.0-local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://sredi_api:sredi_api@localhost:55432/sredi_api
MIGRATION_ACCEPT_SUPABASE_JWT=false
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Dedicated backend-only AES-256-GCM key for the privacy-erasure completion
# notification outbox. Generate 32 random bytes and store their standard base64
# encoding here. Do not reuse auth, token-hash, SMTP, password, or provider keys.
API_PRIVACY_ERASURE_NOTIFICATION_KEY_B64=
API_PRIVACY_ERASURE_NOTIFICATION_KEY_ID=
# Set only to the approved delivery window; no production duration is implied.
API_PRIVACY_ERASURE_NOTIFICATION_DELIVERY_WINDOW_HOURS=

# Private, backend-only, PII-free restore-erasure register. This prefix shares
# the configured private S3-compatible bucket but must be retained independently
# from PostgreSQL backups. Do not expose it to mobile, Vite, or apps/admin.
API_PRIVACY_ERASURE_REGISTER_PREFIX=privacy-erasure-register/v1
