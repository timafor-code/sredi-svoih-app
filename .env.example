# Expo Go on iPhone must reach the API through the development computer's LAN
# address; do not use a loopback address there.
EXPO_PUBLIC_API_URL=http://<computer-lan-ip>:8000

# Non-secret mobile release capabilities. For local Expo Go account testing,
# copy these values into the owner's uncommitted .env.local file.
EXPO_PUBLIC_APP_ACCESS_MODE=account
EXPO_PUBLIC_EVENT_REGISTRATION_MODE=account
